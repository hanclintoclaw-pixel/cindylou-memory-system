{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation"
  ],
  "properties": {
    "operation": {
      "type": "string",
      "enum": [
        "health",
        "search",
        "get"
      ]
    },
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "doc_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "start_line": {
      "type": "integer",
      "minimum": 1
    },
    "lines": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    }
  }
}
